Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 20
      Color: 80; 80; 80
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /av2/lidar
        Reliability Policy: Reliable
        Depth: 5
      Size (m): 0.05
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Use rainbow: false
      Min Color: 90; 90; 90
      Max Color: 255; 255; 255
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Ground truth
      Enabled: true
      Topic:
        Value: /av2/gt/markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracks
      Enabled: true
      Topic:
        Value: /tracks/markers
  Global Options:
    Background Color: 20; 20; 24
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 75
      Focal Point:
        X: 8
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 3.14
      Name: Current View
Window Geometry:
  Displays:
    collapsed: true
  Height: 800
  Width: 1100
  X: 0
  Y: 0
  Hide Left Dock: true
  Hide Right Dock: true
